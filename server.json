{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.echopai/echopai-mcp",
  "title": "EchoPai (回声投研)",
  "description": "China equity & quantitative research MCP server with 50 tools for reports, filings & sentiment.",
  "version": "1.0.1",
  "websiteUrl": "https://echopai.com",
  "repository": {
    "url": "https://github.com/echopai/echopai-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.huishengpai.com/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Optional Bearer API key (Bearer eps_live_...). Omit when using browser OAuth 2.0.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@echopai/mcp",
      "version": "1.0.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ECHOPAI_API_KEY",
          "description": "EchoPai API key (eps_live_...) from https://echopai.com/go/app/agent",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
